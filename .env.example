# Copie para .env. Nunca versione o .env.
DEBUG=true
SECRET_KEY=dev-chave-insegura-trocar-em-producao
ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:5183

# Fora do compose (testes locais): banco do compose exposto em 55433.
DATABASE_URL=postgres://correcao:correcao@localhost:55433/correcao
CELERY_BROKER_URL=redis://localhost:6380/0

# Provedor de LLM: "dumb" (dublê offline, padrão) ou "gemini".
LLM_PROVIDER=dumb
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_PAID_TIER=true só com chave de projeto com faturamento; nunca nível gratuito.
# Sem isso, o sistema recusa pré-avaliar lote real (não sintético) com o Gemini.
GEMINI_PAID_TIER=false

TETO_USD_PADRAO=10
LLM_CONCORRENCIA=8
# 120/m é o padrão para o Gemini (800 chamadas em ~7 min); com o dublê pode subir (ex.: 6000/m).
LLM_RATE_LIMIT=120/m
LLM_MAX_TENTATIVAS=6
TOKENS_SAIDA_ESTIMADOS=1050
LIMITE_CARACTERES_RESPOSTA=15000
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS_SAIDA=8192

# Limite de tentativas de login por IP. Em desenvolvimento com os e2e, use algo como 100/min.
THROTTLE_LOGIN=10/min
